# PostgreSQL connection string. In production this is the PostgreSQL instance already installed
# on the EC2 host — from inside the backend container that host is `host.docker.internal` (see
# docker-compose.yml), from a natively-run backend it is `localhost`. Port 5432 must never be
# open to the internet; the backend reaches it over the host's own loopback.
#
# NEVER COMMIT A REAL VALUE. This file carries placeholders only.
DATABASE_URL="postgresql://nationwide:change-me@localhost:5432/nationwide?schema=public"
REDIS_URL="redis://localhost:6380"

JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV="development"
PORT=4000
# CORS allowlist for this API. Comma-separated to allow a Cloudflare Pages preview domain
# alongside production, e.g. "https://nationwide.pages.dev,https://www.nationwidelogistics.co".
# Never "*": this API is credentialed (the refresh token is an httpOnly cookie).
FRONTEND_URL="http://localhost:3004"

# This backend's own PUBLIC origin — the one Meta's servers can reach from the internet, not an
# internal AWS hostname. Used to build the invoice-download links attached to WhatsApp messages,
# so a wrong value here means invoices are sent with an attachment nobody can open.
# Production example: https://api.nationwidelogistics.co
PUBLIC_BASE_URL="http://localhost:4000"

# Live provider call timeout before falling back to last-known data (Section 4: 5-8s target).
TRACKING_PROVIDER_TIMEOUT_MS=6000
# Cache TTL for shipments still in transit vs. ones already DELIVERED (Section 12: rule-based
# refresh — tune once real ICL rate limits are known, per Section 29).
TRACKING_CACHE_TTL_ACTIVE_SECONDS=300
TRACKING_CACHE_TTL_TERMINAL_SECONDS=86400

# Shared secret for Meta's webhook verification handshake (Section 18) — set this same value in
# the WABA's webhook config once one exists. Not a real Meta credential, we choose this value.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="dev-only-whatsapp-verify-token"
# Meta App Secret — signs the X-Hub-Signature-256 header Meta sends on every webhook POST; the
# webhook rejects any POST with a missing/incorrect signature. Real value comes from the Meta App
# Dashboard -> Settings -> Basic once a real app/WABA exists. Never commit a real value here.
WHATSAPP_APP_SECRET="dev-only-whatsapp-app-secret"

# OUTBOUND sending (invoices, order/tracking notifications) via GUPSHUP, the BSP this WABA is
# onboarded with — NOT Meta's Cloud API directly. All three must be set or the app falls back to
# StubWhatsAppAdapter, which logs at WARN and delivers NOTHING. The boot log states which adapter
# is live; check it after any change here.
#
# GUPSHUP_API_KEY      Gupshup dashboard -> Account -> API key. A secret; never commit a real one.
# GUPSHUP_SOURCE_PHONE The onboarded WABA number. Digits or E.164, both work — the adapter strips
#                      formatting, since Gupshup wants bare digits.
# GUPSHUP_APP_NAME     The Gupshup App name, sent as `src.name`. Must match exactly.
GUPSHUP_API_KEY="changeme"
GUPSHUP_SOURCE_PHONE="918328365513"
GUPSHUP_APP_NAME="NationWide"

# OPTIONAL, and currently unset by design. With no entry here a notification is sent as a
# free-form session message whose wording lives in notifications/message-bodies.ts — no Meta
# approval needed, edited like any other code.
#
# THE LIMIT THAT COMES WITH THAT: WhatsApp only allows free-form messages inside the 24-hour
# customer service window, i.e. within 24 hours of the CUSTOMER's own last message to this
# number. Outside it the platform rejects the send and the notification ends up FAILED. So
# free-form reaches customers who are mid-conversation, and does NOT reach someone who has never
# messaged you — which is most invoice recipients.
#
# Adding an approved template here makes that notification use it instead, with no code change.
# The `params` order is NOT optional: Gupshup takes a positional array while the app passes named
# variables, so a wrong order silently puts the amount where the customer's name belongs. Read
# the approved template body and list its {{1}}, {{2}}... placeholders in order. An invoice
# template must be approved with a DOCUMENT header or the PDF attachment is rejected.
#
# GUPSHUP_TEMPLATES='{"invoice_ready":{"id":"<gupshup-template-id>","params":["customerName","invoiceNumber","amount"]}}'

# ICL's real Tracking API (Section 6/31). Only required once shipping_providers.adapter_class
# is switched from StubShippingProviderAdapter to ICLShippingProviderAdapter for the ICL row.
# Get real credentials from ICL and set them in your local .env (never commit real values here).
# Note: ICL's production host negotiates TLS in a way modern OpenSSL treats as "unsafe legacy
# renegotiation" — the adapter works around this itself (see icl-shipping-provider.adapter.ts),
# no env config needed for that part.
ICL_TRACKING_API_URL="https://cloud.iclinternational.in/api/v1/Tracking/Tracking"
ICL_API_USER_ID="changeme"
ICL_API_PASSWORD="changeme"

# "Continue with Google" on the customer login page — optional; without these, GoogleConfiguredGuard
# returns a clear 503 instead of the app trying (and failing) to redirect to Google. Google login
# only ever authenticates/creates Customer accounts, never STAFF/ADMIN/PICKUP_PARTNER.
#
# To get real values: console.cloud.google.com -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application. Add this exact Authorized redirect URI
# (must match GOOGLE_CALLBACK_URL below, including the /api/v1 prefix):
#   http://localhost:4000/api/v1/auth/google/callback
# For production, add your real backend origin's equivalent callback URL as a second entry.
GOOGLE_CLIENT_ID="changeme.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="changeme"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# ---------------------------------------------------------------------------
# S3 — permanent storage for invoice PDFs, company logos and rate-card PDFs
# ---------------------------------------------------------------------------
# The bucket is PRIVATE (Block Public Access stays on). Nothing is served from the container
# filesystem any more, so these files survive a rebuild, a container recreation and a redeploy.
#
# THERE ARE DELIBERATELY NO AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY VARIABLES.
# On EC2 the AWS SDK picks up the instance IAM role (nantionwides3) automatically through its
# default credential chain. Do not add static keys here — that is how a long-lived AWS credential
# ends up in a shell history, an AMI, or a commit.
#
# For LOCAL development against real S3, use a named profile instead (`aws sso login`, or
# ~/.aws/credentials) and export AWS_PROFILE in your shell — still not in this file.
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="nationwide-logistics-s3"
