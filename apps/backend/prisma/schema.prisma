generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AdminRole {
  CUSTOMER
  STAFF
  ADMIN
  PICKUP_PARTNER
}

enum NotificationChannel {
  WHATSAPP
  SMS
  VOICE
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ShipmentTypeCode {
  DOCUMENT
  PARCEL
  PACKAGE
  OTHER
}

enum FulfillmentMethod {
  PICKUP
  WAREHOUSE_DROP_OFF
}

// The pricing engine (RateProvider/RateCard/WeightSlab) auto-computes RATED options for most
// requests at creation time — see QuotesService.create. NEEDS_MANUAL_REVIEW is the fallback for
// shipment types the engine can't touch (OTHER/oversized) or destinations with no active rate
// card (NO_RATE_AVAILABLE); those still get a staff-entered price via the unchanged manual-quote
// flow. SUBMITTED is retained only for pre-existing rows created before the engine shipped.
// PENDING_PICKUP_REQUEST / PICKUP_REQUESTED are the new self-service-flow states: the customer
// has committed to a price (RATED→PENDING_PICKUP_REQUEST or QUOTED→PENDING_PICKUP_REQUEST) but no
// Order exists yet; PICKUP_REQUESTED means a PickupRequest row now exists and is awaiting a
// Pickup Partner. ACCEPTED still means "an Order exists" — on this new path it's only reached
// once a Pickup Partner completes verification+payment+acceptance (see PickupRequestsService),
// not directly from selectOption/acceptQuote. The legacy admin manual-quote path (Quote.
// fulfillmentMethod set) is unaffected and still jumps straight to ACCEPTED as before.
enum QuoteStatus {
  SUBMITTED
  RATED
  NEEDS_MANUAL_REVIEW
  QUOTED
  PENDING_PICKUP_REQUEST
  PICKUP_REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum QuoteReviewReason {
  OVERSIZED
  DANGEROUS_GOODS
  RESTRICTED_DESTINATION
  SPECIAL_HANDLING
  MISCELLANEOUS
  NO_RATE_AVAILABLE
}

// Shared by both fulfillment methods — a Pickup row represents "how the parcel physically
// reaches us" whether that's a scheduled pickup or a warehouse drop-off. Only the terminal
// state differs (PICKED_UP vs DROPPED_OFF); see PickupsService's transition map.
enum PickupStatus {
  SCHEDULED
  PENDING
  ASSIGNED
  PICKUP_IN_PROGRESS
  PICKED_UP
  CANCELLED
  PICKUP_FAILED
  DROPPED_OFF
}

// The new pre-order lifecycle: a customer's self-service PickupRequest is born PENDING_ASSIGNMENT,
// moves through partner assignment/physical collection, and only reaches COMPLETED once
// PickupRequestsService.acceptParcel has generated the real Order (see Quote.status doc comment
// for how this composes with the Quote state machine).
enum PickupRequestStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  SCHEDULED
  OUT_FOR_PICKUP
  VERIFICATION_PENDING
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// An invoice is a statutory document: once ISSUED its numbers are frozen and it may never be
// edited or deleted, only CANCELLED (which keeps the number consumed, as GST requires — a gap in
// the series is what an auditor asks about).
enum InvoiceStatus {
  ISSUED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  RAZORPAY // reserved, unused until a real gateway is integrated
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

model Customer {
  id                 String   @id @default(uuid()) @map("_id")
  name               String
  phone              String   @unique // E.164 normalized
  email              String?  @unique // required + unique only for self-registered (login-capable) customers
  address            String?
  // Set only for GST-registered (B2B) customers. Null means unregistered/B2C, which changes the
  // place-of-supply rule and whether the recipient GSTIN line prints on the invoice.
  gstin              String?
  passwordHash       String?  @map("password_hash") // null until the customer registers/sets a password
  hashedRefreshToken String?  @map("hashed_refresh_token")
  isActive           Boolean  @default(true) @map("is_active")
  consentGivenAt     DateTime @map("consent_given_at") // DPDP Act: when the customer consented to data collection
  consentSource      String   @map("consent_source") // e.g. 'signup_form', 'staff_entry'
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  orders         Order[]
  quotes         Quote[]
  notifications  Notification[]
  pickupRequests PickupRequest[]
  invoices       Invoice[]

  @@map("customers")
}

model Order {
  id         String      @id @default(uuid()) @map("_id")
  customerId String      @map("customer_id")
  status     OrderStatus @default(PENDING)

  // Payment is tracked directly on Order rather than a separate Payment model — one order has
  // at most one "current" payment state in this phase (no gateway, no partial/split payments,
  // no refund events to track yet). Add a dedicated Payment model later if Razorpay integration
  // needs a real transaction ledger.
  paymentStatus          PaymentStatus  @default(PENDING) @map("payment_status")
  paymentMethod          PaymentMethod? @map("payment_method")
  paidAmount             Float?       @map("paid_amount")
  paidAt                 DateTime?      @map("paid_at")
  paymentMarkedByAdminId String?        @map("payment_marked_by_admin_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer        Customer       @relation(fields: [customerId], references: [id])
  shipments       Shipment[] // 1:many — a single order can produce split shipments
  quote           Quote? // inverse of Quote.orderId, which owns the FK
  pickup          Pickup?
  pickupRequest   PickupRequest? // inverse of PickupRequest.orderId, which owns the FK
  invoice         Invoice? // inverse of Invoice.orderId — at most one issued invoice per order
  paymentMarkedBy AdminUser?     @relation("OrderPaymentMarkedBy", fields: [paymentMarkedByAdminId], references: [id])

  @@index([customerId])
  @@map("orders")
}

/// A customer's shipment request and its pricing/approval lifecycle, from submission through
/// to becoming a real Order (see Quote lifecycle in the implementation plan). Address fields are
/// flat/inline rather than a separate Address model, matching this codebase's existing
/// non-normalized style (Customer.address is a single field too).
model Quote {
  id         String @id @default(uuid()) @map("_id")
  customerId String @map("customer_id")

  shipmentType ShipmentTypeCode @map("shipment_type")
  weightKg     Float          @map("weight_kg")
  description  String?

  // Nullable — the new customer self-service flow (see PickupRequest) no longer collects these at
  // quote-creation time; pickup logistics move to PickupRequest instead. Still populated (and
  // still required at the DTO layer) by the admin manual-quote flow, which is unaffected by this
  // redesign — see CreateAdminQuoteDto.
  originName         String? @map("origin_name")
  originPhone        String? @map("origin_phone")
  originAddressLine1 String? @map("origin_address_line1")
  originAddressLine2 String? @map("origin_address_line2")
  originCity         String? @map("origin_city")
  originState        String? @map("origin_state")
  originPostalCode   String? @map("origin_postal_code")
  originCountry      String? @map("origin_country")
  originInstructions String? @map("origin_instructions")

  destName         String  @map("dest_name")
  destPhone        String  @map("dest_phone")
  destAddressLine1 String  @map("dest_address_line1")
  destAddressLine2 String? @map("dest_address_line2")
  destCity         String  @map("dest_city")
  destState        String  @map("dest_state")
  destPostalCode   String  @map("dest_postal_code")
  destCountry      String  @map("dest_country")

  // Nullable — null on the new customer self-service flow (logistics live on PickupRequest
  // instead) and is exactly the discriminator QuotesService.selectOption/acceptQuote use to tell
  // that flow apart from the legacy admin manual-quote flow (which always sets this). See the
  // QuoteStatus doc comment above.
  fulfillmentMethod FulfillmentMethod? @map("fulfillment_method")
  // Only set when fulfillmentMethod == PICKUP; validated at the service layer (not a DB
  // constraint, matching how OrderStatus transitions aren't DB-enforced either).
  pickupDate        DateTime?          @map("pickup_date")
  pickupTimeSlot    String?            @map("pickup_time_slot") // '09:00-12:00' | '12:00-15:00' | '15:00-18:00'

  status        QuoteStatus        @default(SUBMITTED)
  reviewReason  QuoteReviewReason? @map("review_reason")
  internalNotes String?            @map("internal_notes") // staff-only, never serialized to customer DTOs

  quotedAmount    Float?  @map("quoted_amount")
  quotedCurrency  String?   @default("INR") @map("quoted_currency")
  quotedByAdminId String?   @map("quoted_by_admin_id")
  quotedAt        DateTime? @map("quoted_at")
  rejectionReason String?   @map("rejection_reason")

  // Client-generated idempotency key — see QuotesService.create's duplicate-submission handling.
  submissionKey String  @unique @map("submission_key")
  orderId       String? @unique @map("order_id") // set once accepted, 1:1

  // The provider option the customer picked from a RATED quote's comparison, if any (the
  // manual-quote path never sets this — quotedAmount/quotedCurrency alone cover it there).
  selectedOptionId String?   @unique @map("selected_option_id")
  optionsExpireAt  DateTime? @map("options_expire_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  quotedBy         AdminUser?        @relation("QuoteQuotedBy", fields: [quotedByAdminId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  pickup           Pickup?
  pickupRequest    PickupRequest?
  // NoAction because Quote.selectedOption ⇄ RateQuoteOption.quote is a reference cycle, and
  // MongoDB emulates referential actions in the client rather than in the database.
  selectedOption   RateQuoteOption?  @relation("QuoteSelectedOption", fields: [selectedOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateQuoteOptions RateQuoteOption[] @relation("QuoteRateOptions")

  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

/// The operational fulfillment record — created the instant a quote is accepted, for both
/// PICKUP and WAREHOUSE_DROP_OFF (they're mutually exclusive per quote and share almost
/// identical status/confirmation metadata, so one model covers both rather than two
/// near-duplicates).
model Pickup {
  id      String  @id @default(uuid()) @map("_id")
  quoteId String  @unique @map("quote_id")
  orderId String? @unique @map("order_id") // denorm convenience for the admin order-detail join

  method FulfillmentMethod
  status PickupStatus      @default(SCHEDULED) // only the terminal state differs: PICKED_UP vs DROPPED_OFF

  scheduledDate     DateTime? @map("scheduled_date") // PICKUP only, copied from the quote
  scheduledTimeSlot String?   @map("scheduled_time_slot") // PICKUP only

  assignedStaffId    String?   @map("assigned_staff_id")
  confirmedByAdminId String?   @map("confirmed_by_admin_id") // who marked PICKED_UP / DROPPED_OFF
  confirmedAt        DateTime? @map("confirmed_at")

  weightVerifiedKg Float? @map("weight_verified_kg")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quote            Quote      @relation(fields: [quoteId], references: [id])
  order            Order?     @relation(fields: [orderId], references: [id])
  assignedStaff    AdminUser? @relation("PickupAssignedStaff", fields: [assignedStaffId], references: [id])
  confirmedByAdmin AdminUser? @relation("PickupConfirmedByAdmin", fields: [confirmedByAdminId], references: [id])

  @@index([status])
  @@index([scheduledDate])
  @@map("pickups")
}

/// The new pre-order self-service record — created once a customer has picked a carrier and
/// submitted pickup logistics, and lives entirely BEFORE any Order exists (unlike Pickup above,
/// which is always created the instant a quote is accepted). A PickupRequest is assigned to a
/// PICKUP_PARTNER AdminUser, who physically verifies the parcel (weight/shipmentType, re-priced
/// via the same pricing engine as everywhere else), collects payment, and either accepts (which
/// generates the real Order/Shipment — see PickupRequestsService.acceptParcel) or rejects it. No
/// Pickup row is created for orders that go through this flow — PickupRequest alone fully covers
/// "how the parcel physically reached us" for this path.
model PickupRequest {
  id         String @id @default(uuid()) @map("_id")
  quoteId    String @unique @map("quote_id")
  customerId String @map("customer_id")

  // Denormalized snapshot of the customer's chosen carrier/price/weight at pickup-request time —
  // avoids re-joining Quote/RateQuoteOption for display, and gives recalculate()/verify() a
  // stable rateProviderId to re-price against even if the customer's selectedOption changes later.
  // Nullable — the manual-quote path (QuotesService.setManualQuote) prices a quote as a single
  // staff-entered amount with no specific RateProvider attached at all, so a PickupRequest
  // reached via that path has no carrier to snapshot; recalculate()/verify() fall back to
  // re-running the full pricing engine (unfiltered) instead of re-pricing a specific provider.
  rateProviderId    String?          @map("rate_provider_id")
  rateProviderName  String?          @map("rate_provider_name")
  shipmentType      ShipmentTypeCode @map("shipment_type")
  estimatedWeightKg Float          @map("estimated_weight_kg")
  estimatedPrice    Float          @map("estimated_price")
  currency          String           @default("INR")

  // Pickup logistics — customer-entered, the "Pickup Request page" fields. No destination address
  // here; that's already on the Quote.
  dropAtWarehouse    Boolean   @default(false) @map("drop_at_warehouse")
  pickupContactName  String    @map("pickup_contact_name")
  pickupContactPhone String    @map("pickup_contact_phone")
  pickupAddressLine1 String    @map("pickup_address_line1")
  pickupAddressLine2 String?   @map("pickup_address_line2")
  pickupCity         String    @map("pickup_city")
  pickupState        String    @map("pickup_state")
  pickupPostalCode   String    @map("pickup_postal_code")
  pickupDate         DateTime? @map("pickup_date") // null when dropAtWarehouse
  pickupTimeSlot     String?   @map("pickup_time_slot") // null when dropAtWarehouse
  pickupInstructions String?   @map("pickup_instructions")

  status PickupRequestStatus @default(PENDING_ASSIGNMENT)

  assignedPartnerId String?   @map("assigned_partner_id")
  assignedAt        DateTime? @map("assigned_at")

  // Set the moment the partner confirms they're physically at the pickup location (mobile
  // "Arrived at Pickup" action) — required before verify() will accept a weight correction, so
  // the 3-step Arrived -> Verify/Pay -> Complete workflow can't be skipped.
  arrivedAt DateTime? @map("arrived_at")

  // Verification — Pickup Partner entered, at the customer's location.
  verifiedWeightKg     Float?          @map("verified_weight_kg")
  verifiedShipmentType ShipmentTypeCode? @map("verified_shipment_type")
  verifiedPrice        Float?          @map("verified_price")
  // The pricing engine computes the whole 7-step breakdown to arrive at verifiedPrice, and until
  // invoicing existed only the total was kept. A tax invoice has to state the taxable value and
  // the tax actually charged, and re-deriving those at invoice time would re-price against
  // whatever the rate cards say *then* — so the split is frozen here, at the one moment the
  // price becomes authoritative. Null on rows verified before this shipped, and on the
  // manual-quote path, which never produces a breakdown at all.
  verifiedTaxableSubtotal Float? @map("verified_taxable_subtotal")
  verifiedGstPercent      Float? @map("verified_gst_percent")
  verifiedGstAmount       Float? @map("verified_gst_amount")
  verifiedNationwideCut   Float? @map("verified_nationwide_cut")
  verificationNotes    String?           @map("verification_notes")
  verifiedAt           DateTime?         @map("verified_at")

  // Payment collection — reuses the existing PaymentMethod enum (Order also uses it), copied onto
  // the generated Order by acceptParcel so PATCH /admin/orders/:id/payment's fields aren't stale.
  paymentMethod      PaymentMethod? @map("payment_method")
  collectedAmount    Float?       @map("collected_amount")
  paymentReference   String?        @map("payment_reference") // e.g. UPI transaction ref
  paymentNotes       String?        @map("payment_notes")
  paymentCollectedAt DateTime?      @map("payment_collected_at")

  // Parcel-acceptance checklist.
  parcelPackedProperly   Boolean? @map("parcel_packed_properly")
  weightVerifiedFlag     Boolean? @map("weight_verified_flag")
  restrictedItemsChecked Boolean? @map("restricted_items_checked")
  documentsVerified      Boolean? @map("documents_verified")
  isFragile              Boolean? @map("is_fragile")
  insuranceRequired      Boolean? @map("insurance_required")
  acceptanceRemarks      String?  @map("acceptance_remarks")

  rejectionReason String? @map("rejection_reason")

  orderId String? @unique @map("order_id") // set once acceptParcel generates the real Order

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quote           Quote      @relation(fields: [quoteId], references: [id])
  customer        Customer   @relation(fields: [customerId], references: [id])
  assignedPartner AdminUser? @relation("PickupRequestAssignedPartner", fields: [assignedPartnerId], references: [id])
  order           Order?     @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([assignedPartnerId])
  @@map("pickup_requests")
}

// ---------------------------------------------------------------------------
// Pricing engine — deliberately independent from ShippingProvider below, which is the
// tracking-adapter integration (ICL). RateProvider is pure admin-managed data (FedEx/UPS/DHL/
// DHL Express); adding a new one never requires a code change, only a new RateProvider +
// RateCard rows (see PricingEngineService).
// ---------------------------------------------------------------------------

model RateProvider {
  id                String   @id @default(uuid()) @map("_id")
  code              String   @unique // e.g. 'FEDEX', 'UPS', 'DHL', 'DHL_EXPRESS'
  name              String
  isActive          Boolean  @default(true) @map("is_active")
  // Constant across every country/weight/shipment-type this provider quotes — entered once here
  // instead of on every WeightSlab (see WeightSlab's doc comment). The pricing engine reads these
  // live at quote time; RateQuoteOption freezes a copy so past quotes never change retroactively
  // when an admin updates them.
  fuelChargePercent Float  @default(0) @map("fuel_charge_percent")
  pssPerKg          Float  @default(0) @map("pss_per_kg")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  zones             Zone[]
  zoneCountries     ZoneCountry[]
  rateQuoteOptions  RateQuoteOption[]
  rateCardDocuments RateCardDocument[]

  @@map("rate_providers")
}

model Country {
  id        String   @id @default(uuid()) @map("_id")
  code      String   @unique // ISO 3166-1 alpha-2
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zoneCountries ZoneCountry[]

  @@map("countries")
}

/// A carrier-specific grouping of countries that share the same tariff (e.g. FedEx "Zone A",
/// DHL "Zone 11") — zone definitions are never shared across providers, see ZoneCountry. The
/// admin manages zones directly (unlike RateCard, which stays an invisible grouping key).
model Zone {
  id             String   @id @default(uuid()) @map("_id")
  rateProviderId String   @map("rate_provider_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rateProvider RateProvider  @relation(fields: [rateProviderId], references: [id])
  countries    ZoneCountry[]
  rateCards    RateCard[]

  @@unique([rateProviderId, name])
  @@map("zones")
}

/// rateProviderId is denormalized from zone.rateProviderId specifically so Postgres itself
/// enforces "a country belongs to at most one zone per provider" via the unique index below —
/// reassigning a country to a different zone must go through a single atomic upsert on that same
/// key (see ZonesService.assignCountry), never a find-then-write, to avoid a TOCTOU race on the
/// first-ever assignment of a country under a provider.
model ZoneCountry {
  id             String @id @default(uuid()) @map("_id")
  zoneId         String @map("zone_id")
  countryId      String @map("country_id")
  rateProviderId String @map("rate_provider_id")

  zone         Zone         @relation(fields: [zoneId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  rateProvider RateProvider @relation(fields: [rateProviderId], references: [id])

  @@unique([rateProviderId, countryId])
  @@map("zone_countries")
}

/// A thin, invisible grouping key — exactly one per (zone, shipmentType) pair, auto-created the
/// first time an admin saves a rate for that pair (see RatesService.create's upsert) and never
/// surfaced as its own concept beyond the Zone/Shipment Type pickers in the admin UI.
/// WeightSlab (labeled "Rate" in the UI) is the actual unit of status/editing/audit — see its
/// own doc comment. Deliberately has no rateProviderId of its own — it's fully implied by
/// zoneId -> Zone.rateProviderId, and duplicating it here would let the two silently diverge
/// (Postgres can't enforce two FKs agree with each other declaratively).
model RateCard {
  id               String   @id @default(uuid()) @map("_id")
  zoneId           String   @map("zone_id")
  shipmentType     String   @map("shipment_type") // DOCUMENT | PARCEL | PACKAGE — never OTHER
  currency         String   @default("INR")
  createdByAdminId String   @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  zone      Zone      @relation(fields: [zoneId], references: [id])
  createdBy AdminUser @relation("RateCardCreatedBy", fields: [createdByAdminId], references: [id])

  weightSlabs      WeightSlab[]
  rateQuoteOptions RateQuoteOption[]

  @@unique([zoneId, shipmentType])
  @@map("rate_cards")
}

/// This is "a Rate" from the admin's point of view — the unit of status, editing, and audit.
/// weightFromKg/weightToKg are inclusive on both ends and must not overlap with any other ACTIVE
/// rate under the same (provider, country) pair (validated in RatesService, not DB-enforced).
/// Gaps between ranges are legal — a weight falling in a gap simply produces no option for that
/// provider. Deactivating a rate (isActive: false) excludes it from new quotes without deleting
/// it, preserving its history and any already-computed RateQuoteOption snapshots.
/// Fuel Charge % and PSS are deliberately NOT here — they're constant per provider (PSS scales
/// with weight, not with the country/weight-slab combination), so they live on RateProvider
/// instead and the pricing engine reads them from there at quote time.
model WeightSlab {
  id               String   @id @default(uuid()) @map("_id")
  rateCardId       String   @map("rate_card_id")
  weightFromKg     Float  @map("weight_from_kg")
  weightToKg       Float  @map("weight_to_kg")
  baseRate         Float  @map("base_rate")
  gstPercent       Float  @default(0) @map("gst_percent")
  nationwideCut    Float  @default(0) @map("nationwide_cut")
  isActive         Boolean  @default(true) @map("is_active")
  createdByAdminId String?  @map("created_by_admin_id")
  updatedByAdminId String?  @map("updated_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  rateCard         RateCard          @relation(fields: [rateCardId], references: [id])
  createdBy        AdminUser?        @relation("WeightSlabCreatedBy", fields: [createdByAdminId], references: [id])
  updatedBy        AdminUser?        @relation("WeightSlabUpdatedBy", fields: [updatedByAdminId], references: [id])
  rateQuoteOptions RateQuoteOption[]

  @@index([rateCardId])
  @@map("weight_slabs")
}

/// Frozen snapshot of one provider's computed price for one Quote request — every monetary/
/// percentage value is duplicated here (not just referenced) so a historical quote never changes
/// when the admin later edits or deactivates the rate it was computed from.
model RateQuoteOption {
  id                String   @id @default(uuid()) @map("_id")
  quoteId           String   @map("quote_id")
  rateProviderId    String   @map("rate_provider_id")
  rateCardId        String   @map("rate_card_id")
  weightSlabId      String   @map("weight_slab_id")
  currency          String
  baseRate          Float  @map("base_rate")
  pssAmount         Float  @map("pss_amount")
  fuelChargePercent Float  @map("fuel_charge_percent")
  fuelChargeAmount  Float  @map("fuel_charge_amount")
  taxableSubtotal   Float  @map("taxable_subtotal")
  gstPercent        Float  @map("gst_percent")
  gstAmount         Float  @map("gst_amount")
  nationwideCut     Float  @map("nationwide_cut")
  finalPrice        Float  @map("final_price")
  createdAt         DateTime @default(now()) @map("created_at")

  quote           Quote        @relation("QuoteRateOptions", fields: [quoteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateProvider    RateProvider @relation(fields: [rateProviderId], references: [id])
  rateCard        RateCard     @relation(fields: [rateCardId], references: [id])
  weightSlab      WeightSlab   @relation(fields: [weightSlabId], references: [id])
  selectedByQuote Quote?       @relation("QuoteSelectedOption")

  @@index([quoteId])
  @@map("rate_quote_options")
}

model ShippingProvider {
  id           String   @id @default(uuid()) @map("_id")
  code         String   @unique // e.g. 'ICL'
  name         String
  adapterClass String   @map("adapter_class") // e.g. 'ICLAdapter'
  isActive     Boolean  @default(true) @map("is_active")
  config       Json     @default("{}") // provider-specific config (base URLs, etc.)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shipments               Shipment[]
  externalTrackingNumbers ExternalTrackingNumber[]
  trackingEvents          TrackingEvent[]
  apiRequestLogs          ApiRequestLog[]

  @@map("shipping_providers")
}

model Shipment {
  id                     String    @id @default(uuid()) @map("_id")
  orderId                String    @map("order_id")
  internalTrackingNumber String    @unique @map("internal_tracking_number")
  // DB-assigned, gapless-enough monotonic counter backing internalTrackingNumber's numeric
  // suffix (see tracking-number.ts) — lets staff/customers eyeball creation order and total
  // parcel volume from the tracking number itself, per explicit product decision.
  sequenceNumber         Int       @unique @map("sequence_number")
  providerId             String    @map("provider_id")
  currentStatus          String?   @map("current_status") // denormalized cache of latest canonical status code
  lastSyncedAt           DateTime? @map("last_synced_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  order                   Order                    @relation(fields: [orderId], references: [id])
  provider                ShippingProvider         @relation(fields: [providerId], references: [id])
  externalTrackingNumbers ExternalTrackingNumber[]
  trackingEvents          TrackingEvent[]
  apiRequestLogs          ApiRequestLog[]

  @@index([orderId])
  @@index([providerId])
  @@map("shipments")
}

/// One Shipment can map to many ExternalTrackingNumbers (one per provider/leg used),
/// even though today it is effectively 1:1 with ICL. See architecture doc Section 10.
model ExternalTrackingNumber {
  id                     String   @id @default(uuid()) @map("_id")
  shipmentId             String   @map("shipment_id")
  providerId             String   @map("provider_id")
  externalTrackingNumber String   @map("external_tracking_number")
  rawMetadata            Json?    @map("raw_metadata")
  createdAt              DateTime @default(now()) @map("created_at")

  shipment       Shipment         @relation(fields: [shipmentId], references: [id])
  provider       ShippingProvider @relation(fields: [providerId], references: [id])
  trackingEvents TrackingEvent[]

  @@unique([shipmentId, providerId])
  @@index([providerId, externalTrackingNumber])
  @@map("external_tracking_numbers")
}

model TrackingStatus {
  id           String @id @default(uuid()) @map("_id")
  code         String @unique // PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION, ...
  displayLabel String @map("display_label")

  trackingEvents TrackingEvent[]

  @@map("tracking_statuses")
}

/// Append-only permanent tracking history for a shipment.
model TrackingEvent {
  id                       String   @id @default(uuid()) @map("_id")
  shipmentId               String   @map("shipment_id")
  providerId               String   @map("provider_id")
  externalTrackingNumberId String?  @map("external_tracking_number_id")
  rawStatus                String   @map("raw_status")
  canonicalStatusId        String   @map("canonical_status_id")
  eventTime                DateTime @map("event_time")
  location                 String?
  rawPayload               Json?    @map("raw_payload")
  createdAt                DateTime @default(now()) @map("created_at")

  shipment               Shipment                @relation(fields: [shipmentId], references: [id])
  provider               ShippingProvider        @relation(fields: [providerId], references: [id])
  externalTrackingNumber ExternalTrackingNumber? @relation(fields: [externalTrackingNumberId], references: [id])
  canonicalStatus        TrackingStatus          @relation(fields: [canonicalStatusId], references: [id])

  @@index([shipmentId, createdAt])
  @@map("tracking_events")
}

/// Audit/debug trail for every outbound call to a shipping provider.
model ApiRequestLog {
  id              String   @id @default(uuid()) @map("_id")
  providerId      String   @map("provider_id")
  shipmentId      String?  @map("shipment_id")
  requestUrl      String   @map("request_url")
  requestPayload  Json?    @map("request_payload")
  responseStatus  Int?     @map("response_status")
  responsePayload Json?    @map("response_payload")
  latencyMs       Int?     @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  provider ShippingProvider @relation(fields: [providerId], references: [id])
  shipment Shipment?        @relation(fields: [shipmentId], references: [id])

  @@index([providerId, createdAt])
  @@map("api_request_logs")
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------

model AdminUser {
  id                 String    @id @default(uuid()) @map("_id")
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               AdminRole @default(STAFF)
  isActive           Boolean   @default(true) @map("is_active")
  hashedRefreshToken String?   @map("hashed_refresh_token")
  // Nullable — only populated for PICKUP_PARTNER accounts today (STAFF/ADMIN rows stay NULL),
  // generically useful for any AdminUser going forward.
  name               String?
  phone              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  auditLogs                  AuditLog[]
  quotedQuotes               Quote[]            @relation("QuoteQuotedBy")
  assignedPickups            Pickup[]           @relation("PickupAssignedStaff")
  confirmedPickups           Pickup[]           @relation("PickupConfirmedByAdmin")
  paymentMarkedOrders        Order[]            @relation("OrderPaymentMarkedBy")
  createdRateCards           RateCard[]         @relation("RateCardCreatedBy")
  createdRates               WeightSlab[]       @relation("WeightSlabCreatedBy")
  updatedRates               WeightSlab[]       @relation("WeightSlabUpdatedBy")
  generatedRateCardDocuments RateCardDocument[] @relation("RateCardDocumentGeneratedBy")
  updatedCompanySettings     CompanySettings[]  @relation("CompanySettingsUpdatedBy")
  assignedPickupRequests     PickupRequest[]    @relation("PickupRequestAssignedPartner")
  issuedInvoices             Invoice[]          @relation("InvoiceIssuedBy")

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id                String              @id @default(uuid()) @map("_id")
  customerId        String              @map("customer_id")
  channel           NotificationChannel
  template          String
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?             @unique @map("provider_message_id")
  errorMessage      String?             @map("error_message")
  sentAt            DateTime?           @map("sent_at")
  deliveredAt       DateTime?           @map("delivered_at")
  readAt            DateTime?           @map("read_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid()) @map("_id")
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  // Optional free-text note on why a change was made — surfaced in the admin Rate History view.
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Rate Card Generator
// ---------------------------------------------------------------------------

/// Singleton — the service always reads/creates the single row. Branding/contact/legal-text
/// config that automatically populates every generated Rate Card PDF; never hardcoded in the
/// template itself so changing it here affects every future generation without a deploy.
model CompanySettings {
  id                    String   @id @default(uuid()) @map("_id")
  companyName           String   @default("NationWide")
  tagline               String?
  // Relative path under the backend's storage/ directory, e.g. "logos/<uuid>.png" — the PDF
  // renderer reads this straight off local disk; the admin UI previews it via the /uploads
  // static route (see main.ts).
  logoPath              String?  @map("logo_path")
  primaryColor          String   @default("#4F46E5") @map("primary_color")
  website               String?
  supportEmail          String?  @map("support_email")
  supportPhone          String?  @map("support_phone")
  address               String?
  termsAndConditions    String?  @map("terms_and_conditions")
  footerNotes           String?  @map("footer_notes")
  insuranceDisclaimer   String?  @map("insurance_disclaimer")
  legalDisclaimer       String?  @map("legal_disclaimer")
  restrictedItemsNotice String?  @map("restricted_items_notice")

  // GST identity of the supplier. All nullable because an existing database has none of it, and
  // InvoicesService refuses to issue an invoice until gstin/legalName/address/stateCode are set
  // rather than emitting a document with blanks where the statutory fields belong.
  gstin       String? // 15 chars, e.g. 36AABCU9603R1ZM
  legalName   String? @map("legal_name") // registered name, which may differ from companyName
  stateName   String? @map("state_name") // supplier's registered state — one half of the CGST/SGST vs IGST test
  stateCode   String? @map("state_code") // GST state code, e.g. "36" for Telangana
  // SAC for courier services. Configurable rather than hardcoded: 996812 is courier, 996819 is
  // "other delivery services", and which one applies is the business's call, not this code's.
  sacCode     String? @map("sac_code")

  updatedByAdminId      String?  @map("updated_by_admin_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  updatedBy AdminUser? @relation("CompanySettingsUpdatedBy", fields: [updatedByAdminId], references: [id])

  @@map("company_settings")
}

/// One row per generated (persisted) PDF. Stores the rendered bytes directly so "Download Again"
/// from history always re-serves the exact historical file rather than re-rendering against
/// prices that may have changed since — the same reasoning RateQuoteOption already uses to freeze
/// a quote's pricing at accept time. `preview` generations (see RateCardDocumentsService.preview)
/// deliberately do NOT create a row here, so an admin iterating on a preview doesn't clutter
/// history.
model RateCardDocument {
  id                 String   @id @default(uuid()) @map("_id")
  rateProviderId     String   @map("rate_provider_id")
  shipmentType       String   @map("shipment_type") // DOCUMENT | PARCEL | PACKAGE
  // Countries are selected directly (no required zone in the admin UI) — each may resolve to a
  // different zone/rate card under the provider. Per-country transit time lives in `snapshot`
  // only (see below), not as a column, since it's per-country rather than per-document.
  countryIds         String[] @map("country_ids")
  effectiveDate      DateTime @map("effective_date")
  templateKey        String   @default("CLASSIC") @map("template_key")
  version            Int
  pdf                Bytes
  pdfSizeBytes       Int      @map("pdf_size_bytes")
  // The structured JSON that was actually rendered — an audit trail of exactly what data produced
  // this PDF, and the seed for any future non-PDF export format without re-deriving from pricing.
  snapshot           Json
  generatedByAdminId String   @map("generated_by_admin_id")
  createdAt          DateTime @default(now()) @map("created_at")

  rateProvider RateProvider @relation(fields: [rateProviderId], references: [id])
  generatedBy  AdminUser    @relation("RateCardDocumentGeneratedBy", fields: [generatedByAdminId], references: [id])

  @@index([rateProviderId])
  @@map("rate_card_documents")
}

/// Monotonic sequence counters, one document per sequence name. MongoDB has no autoincrement,
/// so ShipmentsService bumps this with a single atomic $inc (see nextSequenceNumber) and uses
/// the returned value as Shipment.sequenceNumber — same guarantee the Postgres sequence gave.
model Counter {
  id    String @id @map("_id") /// the sequence name, e.g. "shipment"
  value Int    @default(0)

  @@map("counters")
}

// ---------------------------------------------------------------------------
// Invoicing
// ---------------------------------------------------------------------------

/// A GST tax invoice for exactly one Order.
///
/// EVERYTHING STATUTORY IS SNAPSHOTTED, not joined. A tax invoice is a legal record of what was
/// stated at the moment it was issued: if the company later changes its registered address, or a
/// customer updates their GSTIN, or a rate card is re-priced, every invoice already issued must
/// still render exactly as it did. Reading those values through relations at render time would
/// silently rewrite history, so the supplier/recipient/tax columns below are deliberate copies.
/// The relations that remain are for navigation and filtering only.
model Invoice {
  id            String @id @default(uuid()) @map("_id")
  /// Human-facing series, unique across all time, e.g. "NW/2026-27/00042".
  invoiceNumber String @unique @map("invoice_number")
  /// The numeric suffix on its own — the sequence is per financial year, so this is only unique
  /// together with financialYear (see the compound index below).
  sequenceNumber Int    @map("sequence_number")
  /// Indian FY the invoice falls in, "2026-27". GST requires the series to restart each year.
  financialYear  String @map("financial_year")

  orderId    String @unique @map("order_id")
  customerId String @map("customer_id")

  status      InvoiceStatus @default(ISSUED)
  invoiceDate DateTime      @map("invoice_date")

  // --- Supplier snapshot (from CompanySettings at issue time) ---
  supplierName      String  @map("supplier_name")
  supplierGstin     String  @map("supplier_gstin")
  supplierAddress   String  @map("supplier_address")
  supplierStateName String  @map("supplier_state_name")
  supplierStateCode String  @map("supplier_state_code")
  supplierEmail     String? @map("supplier_email")
  supplierPhone     String? @map("supplier_phone")

  // --- Recipient snapshot (from Customer at issue time) ---
  recipientName    String  @map("recipient_name")
  recipientPhone   String  @map("recipient_phone")
  recipientGstin   String? @map("recipient_gstin") // null = unregistered (B2C)
  recipientAddress String? @map("recipient_address")

  /// Where the supply is treated as made. Decides CGST+SGST (intra-state) vs IGST (inter-state),
  /// so it is recorded rather than recomputed.
  placeOfSupplyState String @map("place_of_supply_state")
  placeOfSupplyCode  String @map("place_of_supply_code")
  sacCode            String @map("sac_code")

  // --- Amounts. Exactly one of (cgst+sgst) or igst is ever non-zero. ---
  currency     String @default("INR")
  taxableValue Float  @map("taxable_value")
  cgstRate     Float  @default(0) @map("cgst_rate")
  cgstAmount   Float  @default(0) @map("cgst_amount")
  sgstRate     Float  @default(0) @map("sgst_rate")
  sgstAmount   Float  @default(0) @map("sgst_amount")
  igstRate     Float  @default(0) @map("igst_rate")
  igstAmount   Float  @default(0) @map("igst_amount")
  totalTax     Float  @map("total_tax")
  /// NationWide Cut and anything else added AFTER tax — the pricing engine never taxes it
  /// (pricing-engine.service.ts step 7), so it must sit outside taxableValue or the invoice
  /// would overstate the tax base.
  nonTaxableCharges Float @default(0) @map("non_taxable_charges")
  totalAmount       Float @map("total_amount")

  /// Which record the breakdown came from — RATE_OPTION, PICKUP_VERIFICATION, or
  /// MANUAL_QUOTE_INCLUSIVE (back-derived from a staff-typed gross amount). Kept because the
  /// three are not equally precise and an auditor's first question is where a number came from.
  breakdownSource String @map("breakdown_source")

  /// Relative path under storage/, e.g. "invoices/<id>.pdf". Rendered once at issue time and
  /// served from disk thereafter — re-rendering on each download risks a different document.
  pdfPath String? @map("pdf_path")

  sentAt             DateTime? @map("sent_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  issuedByAdminId    String?   @map("issued_by_admin_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order    Order      @relation(fields: [orderId], references: [id])
  customer Customer   @relation(fields: [customerId], references: [id])
  issuedBy AdminUser? @relation("InvoiceIssuedBy", fields: [issuedByAdminId], references: [id])

  @@unique([financialYear, sequenceNumber])
  @@index([customerId, invoiceDate])
  @@index([invoiceDate])
  @@map("invoices")
}
