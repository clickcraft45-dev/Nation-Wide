generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AdminRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum NotificationChannel {
  WHATSAPP
  SMS
  VOICE
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ShipmentTypeCode {
  DOCUMENT
  PARCEL
  PACKAGE
  OTHER
}

enum FulfillmentMethod {
  PICKUP
  WAREHOUSE_DROP_OFF
}

// The pricing engine (RateProvider/RateCard/WeightSlab) auto-computes RATED options for most
// requests at creation time — see QuotesService.create. NEEDS_MANUAL_REVIEW is the fallback for
// shipment types the engine can't touch (OTHER/oversized) or destinations with no active rate
// card (NO_RATE_AVAILABLE); those still get a staff-entered price via the unchanged manual-quote
// flow. SUBMITTED is retained only for pre-existing rows created before the engine shipped.
enum QuoteStatus {
  SUBMITTED
  RATED
  NEEDS_MANUAL_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum QuoteReviewReason {
  OVERSIZED
  DANGEROUS_GOODS
  RESTRICTED_DESTINATION
  SPECIAL_HANDLING
  MISCELLANEOUS
  NO_RATE_AVAILABLE
}

// Shared by both fulfillment methods — a Pickup row represents "how the parcel physically
// reaches us" whether that's a scheduled pickup or a warehouse drop-off. Only the terminal
// state differs (PICKED_UP vs DROPPED_OFF); see PickupsService's transition map.
enum PickupStatus {
  SCHEDULED
  PENDING
  ASSIGNED
  PICKUP_IN_PROGRESS
  PICKED_UP
  CANCELLED
  PICKUP_FAILED
  DROPPED_OFF
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  RAZORPAY // reserved, unused until a real gateway is integrated
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

model Customer {
  id                 String   @id @default(uuid())
  name               String
  phone              String   @unique // E.164 normalized
  email              String?  @unique // required + unique only for self-registered (login-capable) customers
  address            String?
  passwordHash       String?  @map("password_hash") // null until the customer registers/sets a password
  hashedRefreshToken String?  @map("hashed_refresh_token")
  isActive           Boolean  @default(true) @map("is_active")
  consentGivenAt     DateTime @map("consent_given_at") // DPDP Act: when the customer consented to data collection
  consentSource      String   @map("consent_source") // e.g. 'signup_form', 'staff_entry'
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  orders        Order[]
  quotes        Quote[]
  notifications Notification[]

  @@map("customers")
}

model Order {
  id         String      @id @default(uuid())
  customerId String      @map("customer_id")
  status     OrderStatus @default(PENDING)

  // Payment is tracked directly on Order rather than a separate Payment model — one order has
  // at most one "current" payment state in this phase (no gateway, no partial/split payments,
  // no refund events to track yet). Add a dedicated Payment model later if Razorpay integration
  // needs a real transaction ledger.
  paymentStatus          PaymentStatus  @default(PENDING) @map("payment_status")
  paymentMethod          PaymentMethod? @map("payment_method")
  paidAmount             Decimal?       @map("paid_amount") @db.Decimal(10, 2)
  paidAt                 DateTime?      @map("paid_at")
  paymentMarkedByAdminId String?        @map("payment_marked_by_admin_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer        Customer   @relation(fields: [customerId], references: [id])
  shipments       Shipment[] // 1:many — a single order can produce split shipments
  quote           Quote? // inverse of Quote.orderId, which owns the FK
  pickup          Pickup?
  paymentMarkedBy AdminUser? @relation("OrderPaymentMarkedBy", fields: [paymentMarkedByAdminId], references: [id])

  @@index([customerId])
  @@map("orders")
}

/// A customer's shipment request and its pricing/approval lifecycle, from submission through
/// to becoming a real Order (see Quote lifecycle in the implementation plan). Address fields are
/// flat/inline rather than a separate Address model, matching this codebase's existing
/// non-normalized style (Customer.address is a single field too).
model Quote {
  id         String @id @default(uuid())
  customerId String @map("customer_id")

  shipmentType ShipmentTypeCode @map("shipment_type")
  weightKg     Decimal          @map("weight_kg") @db.Decimal(10, 2)
  description  String?

  originName         String  @map("origin_name")
  originPhone        String  @map("origin_phone")
  originAddressLine1 String  @map("origin_address_line1")
  originAddressLine2 String? @map("origin_address_line2")
  originCity         String  @map("origin_city")
  originState        String  @map("origin_state")
  originPostalCode   String  @map("origin_postal_code")
  originCountry      String  @map("origin_country")
  originInstructions String? @map("origin_instructions")

  destName         String  @map("dest_name")
  destPhone        String  @map("dest_phone")
  destAddressLine1 String  @map("dest_address_line1")
  destAddressLine2 String? @map("dest_address_line2")
  destCity         String  @map("dest_city")
  destState        String  @map("dest_state")
  destPostalCode   String  @map("dest_postal_code")
  destCountry      String  @map("dest_country")

  fulfillmentMethod FulfillmentMethod @map("fulfillment_method")
  // Only set when fulfillmentMethod == PICKUP; validated at the service layer (not a DB
  // constraint, matching how OrderStatus transitions aren't DB-enforced either).
  pickupDate        DateTime?         @map("pickup_date") @db.Date
  pickupTimeSlot    String?           @map("pickup_time_slot") // '09:00-12:00' | '12:00-15:00' | '15:00-18:00'

  status        QuoteStatus        @default(SUBMITTED)
  reviewReason  QuoteReviewReason? @map("review_reason")
  internalNotes String?            @map("internal_notes") // staff-only, never serialized to customer DTOs

  quotedAmount    Decimal?  @map("quoted_amount") @db.Decimal(10, 2)
  quotedCurrency  String?   @default("INR") @map("quoted_currency")
  quotedByAdminId String?   @map("quoted_by_admin_id")
  quotedAt        DateTime? @map("quoted_at")
  rejectionReason String?   @map("rejection_reason")

  // Client-generated idempotency key — see QuotesService.create's duplicate-submission handling.
  submissionKey String  @unique @map("submission_key")
  orderId       String? @unique @map("order_id") // set once accepted, 1:1

  // The provider option the customer picked from a RATED quote's comparison, if any (the
  // manual-quote path never sets this — quotedAmount/quotedCurrency alone cover it there).
  selectedOptionId String?   @unique @map("selected_option_id")
  optionsExpireAt  DateTime? @map("options_expire_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  quotedBy         AdminUser?        @relation("QuoteQuotedBy", fields: [quotedByAdminId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  pickup           Pickup?
  selectedOption   RateQuoteOption?  @relation("QuoteSelectedOption", fields: [selectedOptionId], references: [id])
  rateQuoteOptions RateQuoteOption[] @relation("QuoteRateOptions")

  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

/// The operational fulfillment record — created the instant a quote is accepted, for both
/// PICKUP and WAREHOUSE_DROP_OFF (they're mutually exclusive per quote and share almost
/// identical status/confirmation metadata, so one model covers both rather than two
/// near-duplicates).
model Pickup {
  id      String  @id @default(uuid())
  quoteId String  @unique @map("quote_id")
  orderId String? @unique @map("order_id") // denorm convenience for the admin order-detail join

  method FulfillmentMethod
  status PickupStatus      @default(SCHEDULED) // only the terminal state differs: PICKED_UP vs DROPPED_OFF

  scheduledDate     DateTime? @map("scheduled_date") @db.Date // PICKUP only, copied from the quote
  scheduledTimeSlot String?   @map("scheduled_time_slot") // PICKUP only

  assignedStaffId    String?   @map("assigned_staff_id")
  confirmedByAdminId String?   @map("confirmed_by_admin_id") // who marked PICKED_UP / DROPPED_OFF
  confirmedAt        DateTime? @map("confirmed_at")

  weightVerifiedKg Decimal? @map("weight_verified_kg") @db.Decimal(10, 2)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quote            Quote      @relation(fields: [quoteId], references: [id])
  order            Order?     @relation(fields: [orderId], references: [id])
  assignedStaff    AdminUser? @relation("PickupAssignedStaff", fields: [assignedStaffId], references: [id])
  confirmedByAdmin AdminUser? @relation("PickupConfirmedByAdmin", fields: [confirmedByAdminId], references: [id])

  @@index([status])
  @@index([scheduledDate])
  @@map("pickups")
}

// ---------------------------------------------------------------------------
// Pricing engine — deliberately independent from ShippingProvider below, which is the
// tracking-adapter integration (ICL). RateProvider is pure admin-managed data (FedEx/UPS/DHL/
// DHL Express); adding a new one never requires a code change, only a new RateProvider +
// RateCard rows (see PricingEngineService).
// ---------------------------------------------------------------------------

model RateProvider {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. 'FEDEX', 'UPS', 'DHL', 'DHL_EXPRESS'
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zones            Zone[]
  zoneCountries    ZoneCountry[]
  rateQuoteOptions RateQuoteOption[]

  @@map("rate_providers")
}

model Country {
  id        String   @id @default(uuid())
  code      String   @unique // ISO 3166-1 alpha-2
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zoneCountries ZoneCountry[]

  @@map("countries")
}

/// A carrier-specific grouping of countries that share the same tariff (e.g. FedEx "Zone A",
/// DHL "Zone 11") — zone definitions are never shared across providers, see ZoneCountry. The
/// admin manages zones directly (unlike RateCard, which stays an invisible grouping key).
model Zone {
  id             String   @id @default(uuid())
  rateProviderId String   @map("rate_provider_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rateProvider RateProvider  @relation(fields: [rateProviderId], references: [id])
  countries    ZoneCountry[]
  rateCards    RateCard[]

  @@unique([rateProviderId, name])
  @@map("zones")
}

/// rateProviderId is denormalized from zone.rateProviderId specifically so Postgres itself
/// enforces "a country belongs to at most one zone per provider" via the unique index below —
/// reassigning a country to a different zone must go through a single atomic upsert on that same
/// key (see ZonesService.assignCountry), never a find-then-write, to avoid a TOCTOU race on the
/// first-ever assignment of a country under a provider.
model ZoneCountry {
  id             String @id @default(uuid())
  zoneId         String @map("zone_id")
  countryId      String @map("country_id")
  rateProviderId String @map("rate_provider_id")

  zone         Zone         @relation(fields: [zoneId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  rateProvider RateProvider @relation(fields: [rateProviderId], references: [id])

  @@unique([rateProviderId, countryId])
  @@map("zone_countries")
}

/// A thin, invisible grouping key — exactly one per (zone, shipmentType) pair, auto-created the
/// first time an admin saves a rate for that pair (see RatesService.create's upsert) and never
/// surfaced as its own concept beyond the Zone/Shipment Type pickers in the admin UI.
/// WeightSlab (labeled "Rate" in the UI) is the actual unit of status/editing/audit — see its
/// own doc comment. Deliberately has no rateProviderId of its own — it's fully implied by
/// zoneId -> Zone.rateProviderId, and duplicating it here would let the two silently diverge
/// (Postgres can't enforce two FKs agree with each other declaratively).
model RateCard {
  id               String   @id @default(uuid())
  zoneId           String   @map("zone_id")
  shipmentType     String   @map("shipment_type") // DOCUMENT | PARCEL | PACKAGE — never OTHER
  currency         String   @default("INR")
  createdByAdminId String   @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  zone      Zone      @relation(fields: [zoneId], references: [id])
  createdBy AdminUser @relation("RateCardCreatedBy", fields: [createdByAdminId], references: [id])

  weightSlabs      WeightSlab[]
  rateQuoteOptions RateQuoteOption[]

  @@unique([zoneId, shipmentType])
  @@map("rate_cards")
}

/// This is "a Rate" from the admin's point of view — the unit of status, editing, and audit.
/// weightFromKg/weightToKg are inclusive on both ends and must not overlap with any other ACTIVE
/// rate under the same (provider, country) pair (validated in RatesService, not DB-enforced).
/// Gaps between ranges are legal — a weight falling in a gap simply produces no option for that
/// provider. Deactivating a rate (isActive: false) excludes it from new quotes without deleting
/// it, preserving its history and any already-computed RateQuoteOption snapshots.
model WeightSlab {
  id                String   @id @default(uuid())
  rateCardId        String   @map("rate_card_id")
  weightFromKg      Decimal  @map("weight_from_kg") @db.Decimal(10, 2)
  weightToKg        Decimal  @map("weight_to_kg") @db.Decimal(10, 2)
  baseRate          Decimal  @map("base_rate") @db.Decimal(10, 2)
  pssAmount         Decimal  @default(0) @map("pss_amount") @db.Decimal(10, 2)
  fuelChargePercent Decimal  @default(0) @map("fuel_charge_percent") @db.Decimal(5, 2)
  gstPercent        Decimal  @default(0) @map("gst_percent") @db.Decimal(5, 2)
  nationwideCut     Decimal  @default(0) @map("nationwide_cut") @db.Decimal(10, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdByAdminId  String?  @map("created_by_admin_id")
  updatedByAdminId  String?  @map("updated_by_admin_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  rateCard         RateCard          @relation(fields: [rateCardId], references: [id])
  createdBy        AdminUser?        @relation("WeightSlabCreatedBy", fields: [createdByAdminId], references: [id])
  updatedBy        AdminUser?        @relation("WeightSlabUpdatedBy", fields: [updatedByAdminId], references: [id])
  rateQuoteOptions RateQuoteOption[]

  @@index([rateCardId])
  @@map("weight_slabs")
}

/// Frozen snapshot of one provider's computed price for one Quote request — every monetary/
/// percentage value is duplicated here (not just referenced) so a historical quote never changes
/// when the admin later edits or deactivates the rate it was computed from.
model RateQuoteOption {
  id                String   @id @default(uuid())
  quoteId           String   @map("quote_id")
  rateProviderId    String   @map("rate_provider_id")
  rateCardId        String   @map("rate_card_id")
  weightSlabId      String   @map("weight_slab_id")
  currency          String
  baseRate          Decimal  @map("base_rate") @db.Decimal(10, 2)
  pssAmount         Decimal  @map("pss_amount") @db.Decimal(10, 2)
  fuelChargePercent Decimal  @map("fuel_charge_percent") @db.Decimal(5, 2)
  fuelChargeAmount  Decimal  @map("fuel_charge_amount") @db.Decimal(10, 2)
  taxableSubtotal   Decimal  @map("taxable_subtotal") @db.Decimal(10, 2)
  gstPercent        Decimal  @map("gst_percent") @db.Decimal(5, 2)
  gstAmount         Decimal  @map("gst_amount") @db.Decimal(10, 2)
  nationwideCut     Decimal  @map("nationwide_cut") @db.Decimal(10, 2)
  finalPrice        Decimal  @map("final_price") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  quote           Quote        @relation("QuoteRateOptions", fields: [quoteId], references: [id])
  rateProvider    RateProvider @relation(fields: [rateProviderId], references: [id])
  rateCard        RateCard     @relation(fields: [rateCardId], references: [id])
  weightSlab      WeightSlab   @relation(fields: [weightSlabId], references: [id])
  selectedByQuote Quote?       @relation("QuoteSelectedOption")

  @@index([quoteId])
  @@map("rate_quote_options")
}

model ShippingProvider {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. 'ICL'
  name         String
  adapterClass String   @map("adapter_class") // e.g. 'ICLAdapter'
  isActive     Boolean  @default(true) @map("is_active")
  config       Json     @default("{}") // provider-specific config (base URLs, etc.)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shipments               Shipment[]
  externalTrackingNumbers ExternalTrackingNumber[]
  trackingEvents          TrackingEvent[]
  apiRequestLogs          ApiRequestLog[]

  @@map("shipping_providers")
}

model Shipment {
  id                     String    @id @default(uuid())
  orderId                String    @map("order_id")
  internalTrackingNumber String    @unique @map("internal_tracking_number")
  // DB-assigned, gapless-enough monotonic counter backing internalTrackingNumber's numeric
  // suffix (see tracking-number.ts) — lets staff/customers eyeball creation order and total
  // parcel volume from the tracking number itself, per explicit product decision.
  sequenceNumber         Int       @unique @default(autoincrement()) @map("sequence_number")
  providerId             String    @map("provider_id")
  currentStatus          String?   @map("current_status") // denormalized cache of latest canonical status code
  lastSyncedAt           DateTime? @map("last_synced_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  order                   Order                    @relation(fields: [orderId], references: [id])
  provider                ShippingProvider         @relation(fields: [providerId], references: [id])
  externalTrackingNumbers ExternalTrackingNumber[]
  trackingEvents          TrackingEvent[]
  apiRequestLogs          ApiRequestLog[]

  @@index([orderId])
  @@index([providerId])
  @@map("shipments")
}

/// One Shipment can map to many ExternalTrackingNumbers (one per provider/leg used),
/// even though today it is effectively 1:1 with ICL. See architecture doc Section 10.
model ExternalTrackingNumber {
  id                     String   @id @default(uuid())
  shipmentId             String   @map("shipment_id")
  providerId             String   @map("provider_id")
  externalTrackingNumber String   @map("external_tracking_number")
  rawMetadata            Json?    @map("raw_metadata")
  createdAt              DateTime @default(now()) @map("created_at")

  shipment       Shipment         @relation(fields: [shipmentId], references: [id])
  provider       ShippingProvider @relation(fields: [providerId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([shipmentId])
  @@index([providerId, externalTrackingNumber])
  @@map("external_tracking_numbers")
}

model TrackingStatus {
  id           String @id @default(uuid())
  code         String @unique // PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION, ...
  displayLabel String @map("display_label")

  trackingEvents TrackingEvent[]

  @@map("tracking_statuses")
}

/// Append-only permanent tracking history for a shipment.
model TrackingEvent {
  id                       String   @id @default(uuid())
  shipmentId               String   @map("shipment_id")
  providerId               String   @map("provider_id")
  externalTrackingNumberId String?  @map("external_tracking_number_id")
  rawStatus                String   @map("raw_status")
  canonicalStatusId        String   @map("canonical_status_id")
  eventTime                DateTime @map("event_time")
  location                 String?
  rawPayload               Json?    @map("raw_payload")
  createdAt                DateTime @default(now()) @map("created_at")

  shipment               Shipment                @relation(fields: [shipmentId], references: [id])
  provider               ShippingProvider        @relation(fields: [providerId], references: [id])
  externalTrackingNumber ExternalTrackingNumber? @relation(fields: [externalTrackingNumberId], references: [id])
  canonicalStatus        TrackingStatus          @relation(fields: [canonicalStatusId], references: [id])

  @@index([shipmentId, createdAt])
  @@map("tracking_events")
}

/// Audit/debug trail for every outbound call to a shipping provider.
model ApiRequestLog {
  id              String   @id @default(uuid())
  providerId      String   @map("provider_id")
  shipmentId      String?  @map("shipment_id")
  requestUrl      String   @map("request_url")
  requestPayload  Json?    @map("request_payload")
  responseStatus  Int?     @map("response_status")
  responsePayload Json?    @map("response_payload")
  latencyMs       Int?     @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  provider ShippingProvider @relation(fields: [providerId], references: [id])
  shipment Shipment?        @relation(fields: [shipmentId], references: [id])

  @@index([providerId, createdAt])
  @@map("api_request_logs")
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------

model AdminUser {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               AdminRole @default(STAFF)
  isActive           Boolean   @default(true) @map("is_active")
  hashedRefreshToken String?   @map("hashed_refresh_token")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  auditLogs           AuditLog[]
  quotedQuotes        Quote[]      @relation("QuoteQuotedBy")
  assignedPickups     Pickup[]     @relation("PickupAssignedStaff")
  confirmedPickups    Pickup[]     @relation("PickupConfirmedByAdmin")
  paymentMarkedOrders Order[]      @relation("OrderPaymentMarkedBy")
  createdRateCards    RateCard[]   @relation("RateCardCreatedBy")
  createdRates        WeightSlab[] @relation("WeightSlabCreatedBy")
  updatedRates        WeightSlab[] @relation("WeightSlabUpdatedBy")

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id                String              @id @default(uuid())
  customerId        String              @map("customer_id")
  channel           NotificationChannel
  template          String
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?             @unique @map("provider_message_id")
  errorMessage      String?             @map("error_message")
  sentAt            DateTime?           @map("sent_at")
  deliveredAt       DateTime?           @map("delivered_at")
  readAt            DateTime?           @map("read_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
