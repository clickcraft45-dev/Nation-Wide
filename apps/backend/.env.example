DATABASE_URL="postgresql://nationwide:nationwide_dev@localhost:5433/nationwide?schema=public"
REDIS_URL="redis://localhost:6380"

JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
FRONTEND_URL="http://localhost:3004"

# Live provider call timeout before falling back to last-known data (Section 4: 5-8s target).
TRACKING_PROVIDER_TIMEOUT_MS=6000
# Cache TTL for shipments still in transit vs. ones already DELIVERED (Section 12: rule-based
# refresh — tune once real ICL rate limits are known, per Section 29).
TRACKING_CACHE_TTL_ACTIVE_SECONDS=300
TRACKING_CACHE_TTL_TERMINAL_SECONDS=86400

# Shared secret for Meta's webhook verification handshake (Section 18) — set this same value in
# the WABA's webhook config once one exists. Not a real Meta credential, we choose this value.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="dev-only-whatsapp-verify-token"
