# Cloudflare static-asset headers (OpenNext copies public/ into the Worker's assets).
# Photos, icons and logos change rarely but keep their names when they do, so a week of
# browser reuse plus a day of serve-stale-while-checking, not "immutable".
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Next's build output: every filename carries a content hash, so a changed file is a new URL.
# Without this, Workers assets answer max-age=0 and every page view re-checks every chunk.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be served from a cache, or a fix to it (or to push handling)
# reaches phones only when the cached copy happens to expire.
/sw.js
  Cache-Control: no-cache
